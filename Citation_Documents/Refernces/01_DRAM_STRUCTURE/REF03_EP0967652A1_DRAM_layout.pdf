                  <patent:NumberOfPages>1</patent:NumberOfPages>
               </rdf:li>
            </rdf:Seq>
         </patent:DocumentStructure>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/"
