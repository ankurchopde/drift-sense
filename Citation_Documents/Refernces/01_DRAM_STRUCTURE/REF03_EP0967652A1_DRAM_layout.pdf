      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>EP-0967652-A1-19991229</dc:identifier>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A memory cell structure (10) includes a plurality of bit lines (12) and intersecting word lines (14). Bit line contacts (16) are spaced evenly apart on an associated bit line (12). A plurality of storage nodes (20) and associated storage node contacts (18) are provided. Storage nodes (20) and storage node contacts (2) are spaced evenly apart along the associated bit line (12). The storage nodes (20) and storage node contacts (18) are offset with respect to storage nodes (20) and storage node contacts (18) placed along adjacent bit lines (12). [image]</rdf:li>
               <rdf:li xml:lang="en">A memory cell structure (10) includes a plurality of bit lines (12) and intersecting word lines (14). Bit line contacts (16) are spaced evenly apart on an associated bit line (12). A plurality of storage nodes (20) and associated storage node contacts (18) are provided. Storage nodes (20) and storage node contacts (2) are spaced evenly apart along the associated bit line (12). The storage nodes (20) and storage node contacts (18) are offset with respect to storage nodes (20) and storage node contacts (18) placed along adjacent bit lines (12). [image]</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:language>
            <rdf:Bag>
               <rdf:li>en</rdf:li>
            </rdf:Bag>
         </dc:language>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>European Patent Office</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>EP0967652</rdf:li>
               <rdf:li>EP 0967652</rdf:li>
               <rdf:li>H01L 27/108</rdf:li>
               <rdf:li>DRAM cell array layout</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">DRAM cell array layout - European Patent Office - EP 0967652 A1</rdf:li>
               <rdf:li xml:lang="en">DRAM cell array layout - European Patent Office - EP 0967652 A1</rdf:li>
            </rdf:Alt>
